# Copy this file to `.env.local` and fill in your values.

# Solana RPC used for ordinary reads and transaction submission.
# A Helius endpoint (recommended) gives faster, more reliable
# `getProgramAccounts` polling for the poll list.
NEXT_PUBLIC_SOLANA_RPC_URL=https://devnet.helius-rpc.com?api-key=YOUR_HELIUS_API_KEY

# Light / ZK Compression RPC (required for "Mint tickets" and "Cast vote").
# The plain devnet.solana.com endpoint does NOT support the compression
# JSON-RPC methods. Point this at a Helius devnet RPC that includes your key:
NEXT_PUBLIC_LIGHT_RPC_URL=https://devnet.helius-rpc.com?api-key=YOUR_HELIUS_API_KEY

# Optional: a dedicated prover endpoint. Defaults to NEXT_PUBLIC_LIGHT_RPC_URL.
# NEXT_PUBLIC_LIGHT_PROVER_URL=
